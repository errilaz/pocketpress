  "devDependencies": {
    "@types/cssesc": "^3.0.0",
    "@types/escape-html": "^1.0.2",
    "@types/marked": "^4.0.8",
    "@types/node": "^18.11.18",
    "html-tags": "^3.2.0",
    "known-css-properties": "^0.26.0",
