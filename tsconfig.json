{
  "compilerOptions": {
    "target": "ES2018",
    "module": "preserve",
    "lib": ["ES2020"],
    "types": ["node"],
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
  },
  "include": ["src"]
}
